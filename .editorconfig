# TxnVigil v2 — editor settings (CP-0a D3)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{py,pyi,toml}]
indent_style = space
indent_size = 4

[*.{yaml,yml,json,js,jsx,mjs,cjs,ts,tsx,css,html}]
indent_style = space
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.{ps1,bat}]
end_of_line = crlf
