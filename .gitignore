# TxnVigil v2 — ignore rules (NFR-06: no secrets in repo; CP-0a D-D R6)
# Lock files (uv.lock, pnpm-lock.yaml) are intentionally NOT ignored (CP-0 K2).

# --- Python (v1 entries kept: __pycache__/, *.pyc, .venv/) ---
__pycache__/
*.py[cod]
*.pyc
.venv/
*.egg-info/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Data (v1 entry data/ anchored to repo root so test fixtures named data/ are not hidden) ---
/data/
/data/external/
lake/

# --- ML tracking ---
mlruns/
mlartifacts/

# --- Test / lint / coverage ---
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Frontend ---
node_modules/
web/dist/
.pnpm-store/

# --- Reports ---
reports/perf/raw/

# --- Logs ---
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
